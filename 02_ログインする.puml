@startuml
title ログインする
skinparam defaultFontName "Noto Sans CJK JP"
skinparam monochrome true

actor "保護者/保護者の関係者/専門家" as A
boundary "login.html" as LP
control "login_view" as LV
entity "User" as UM
boundary "record_list.html" as RLP
control "record_list_view" as RLV
boundary "inbox.html" as IBP
control "inbox_view" as IBV

' 最初の画面表示
A -> LP : ログイン画面を開く
LP -> LV : GET（）
LV --> LP : 表示する

A -> LP : ②メールアドレスとパスワードを入力し、\nログインボタンをクリックする
LP -> LV : POST（メールアドレス、パスワード）
alt 未入力の場合
  LV --> LP : 「メールアドレスとパスワードを入力してください」と表示する
else 入力されている場合
  LV -> UM : 利用者データを取得する（メールアドレス）
  LV <-- UM : メールアドレスデータ・パスワードデータを返却
  LV -> LV : ログイン処理を実行する
  alt メールアドレスまたはパスワードが誤っている場合
    LV --> LP : 「ログイン情報が正しくありません」と表示し、再入力を促す
  else 正しい場合
    LV -> UM : 種別データを取得する
    LV <-- UM : 種別データを返却
    alt 専門家ではない場合
      LV --> LP : リダイレクト（302：/records/）
      RLP -> RLV : GET（自動的な新しいリクエスト）
      RLV --> RLP : 表示する（ログイン成功メッセージ）
    else 専門家の場合
      LV --> LP : リダイレクト（302：/experts/）
      IBP -> IBV : GET（自動的な新しいリクエスト）
      IBV --> IBP : 表示する（ログイン成功メッセージ）
    end
  end
end
@enduml
